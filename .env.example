# The public GitHub Pages demo works without environment variables.
# Server mode can use PostgreSQL for persistence.
DATABASE_URL="postgresql://user:password@localhost:5432/vigie"
DATABASE_SSL="disable"
DATABASE_SSL_REJECT_UNAUTHORIZED="true"
DATABASE_POOL_MAX="10"

# Local development actor only. Production server mode deliberately refuses
# to invent an authenticated user until a real identity provider is connected.
VIGIE_DEMO_ORGANIZATION_ID="00000000-0000-4000-8000-000000000001"
VIGIE_DEMO_USER_ID="00000000-0000-4000-8000-000000000002"
VIGIE_DEMO_ROLE="owner"

LEGAL_DATA_MODE="demo"
